#!/system/bin/sh
set -eu

MODDIR=${0%/*}
CLASHCTL_HOME="${CLASHCTL_HOME:-/data/adb/modules/clashctl}"
BIN="$CLASHCTL_HOME/system/bin/clashctl"

if [ -x "$BIN" ]; then
  "$BIN" stop || true
fi

rm -rf "$CLASHCTL_HOME/data" "$CLASHCTL_HOME/system/bin/mihomo" || true

echo "Uninstalled KernelSU module resources."
